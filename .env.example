# Supabase — project URL + keys (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role bypasses RLS — server-only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Shared secret gating the whole app (single-user access control).
# Leave blank in local dev to disable the gate.
SITE_PASSWORD=
